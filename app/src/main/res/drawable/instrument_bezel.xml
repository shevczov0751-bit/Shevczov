<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#000000"/>
            <stroke
                android:width="4dp"
                android:color="#202020"/>
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">

        <shape android:shape="oval">
            <solid android:color="#000000"/>

            <stroke
                android:width="3dp"
                android:color="#333333"/>

        </shape>
    </item>
</layer-list>